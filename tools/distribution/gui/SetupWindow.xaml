<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aion Aetherfall — Installer &amp; Updater Hub"
 Width="1180" Height="744" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
 Background="Transparent" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="#EEF4F5">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#F6EEE0"/>
   <Setter Property="Background" Value="#1B1F38"/><Setter Property="BorderBrush" Value="#669A8C6E"/>
   <Setter Property="Padding" Value="14,10"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
     BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="#2D355C"/><Setter TargetName="Plate" Property="BorderBrush" Value="#E8CB91"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#E8CB91"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.72"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,9"/>
   <Setter Property="Padding" Value="14,13"/>
  </Style>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#F2EBDD"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,22,0"/></Style>
 </Window.Resources>
 <Viewbox Stretch="Uniform"><Grid x:Name="Scene" Width="1180" Height="744">
  <Border Margin="13" Background="#080B18" CornerRadius="19"/>
  <Border Margin="17" CornerRadius="17" ClipToBounds="True"><Grid>
   <Image x:Name="Hero" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
    <Image.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="1"/></Image.RenderTransform>
   </Image>
   <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F60A0D1D" Offset="0"/><GradientStop Color="#EA0E1328" Offset="0.24"/><GradientStop Color="#B8121933" Offset="0.52"/><GradientStop Color="#220D1326" Offset="0.82"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#FF080B18" Offset="0"/><GradientStop Color="#F20B1022" Offset="0.22"/><GradientStop Color="#100B1022" Offset="0.68"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <Canvas x:Name="Motes" IsHitTestVisible="False" ClipToBounds="True"/>
  </Grid></Border>
  <Border x:Name="DragArea" Margin="60,32,146,0" Height="116" VerticalAlignment="Top" Background="Transparent"/>
  <StackPanel Margin="148,52,0,0" Width="355" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
   <Image x:Name="AionLogo" Width="173" Height="45" Stretch="Uniform"/>
   <Image x:Name="AetherfallLogo" Width="355" Height="80" Stretch="Uniform" Margin="0,-1,0,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
    <Rectangle Width="26" Height="1" Fill="#E5C78D" VerticalAlignment="Center"/>
    <TextBlock x:Name="ReleaseLabel" Text="  REPACK HUB &amp; AUTO-UPDATER  ·  0.86" FontSize="10" Foreground="#E5C78D"/>
    <Rectangle Width="26" Height="1" Fill="#E5C78D" VerticalAlignment="Center" Margin="8,0,0,0"/>
   </StackPanel>
  </StackPanel>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,81,171,0">
   <Button x:Name="Minimize" Content="−" Width="32" Height="29" Padding="0" Margin="0,0,7,0" Background="#A60A0E1F" ToolTip="Minimize"/>
   <Button x:Name="Exit" Content="×" Width="32" Height="29" Padding="0" Background="#A60A0E1F" ToolTip="Close"/>
  </StackPanel>

  <StackPanel Margin="60,214,0,0" Width="186" HorizontalAlignment="Left" VerticalAlignment="Top">
   <Button x:Name="HubTab" Style="{StaticResource Nav}" Background="#B8252C4E" BorderBrush="#749B8E6E"><TextBlock Text="❖    INSTALL &amp; UPDATE" FontSize="12"/></Button>
   <Button x:Name="ServersTab" Style="{StaticResource Nav}"><TextBlock Text="⚡    SERVER CONTROL" FontSize="12"/></Button>
   <Button x:Name="PathsTab" Style="{StaticResource Nav}"><TextBlock Text="⚙    PATHS &amp; MIRRORS" FontSize="12"/></Button>
   <Border Height="1" Background="#497F829E" Margin="14,15,18,18"/>
   <TextBlock Text="REPACK STATUS" Foreground="#C4C8DE" FontSize="10" Margin="14,0,0,10"/>
   <StackPanel Orientation="Horizontal" Margin="14,0,0,6"><Ellipse x:Name="InstallDot" Width="7" Height="7" Fill="#E0B580" Margin="0,0,8,0"/><TextBlock x:Name="InstallBadge" Text="Not installed yet" FontSize="12" Foreground="#F0E4CC"/></StackPanel>
   <StackPanel Orientation="Horizontal" Margin="14,0,0,6"><Ellipse x:Name="DbDot" Width="7" Height="7" Fill="#7E8B9B" Margin="0,0,8,0"/><TextBlock x:Name="DbBadge" Text="Database stopped" FontSize="11" Foreground="#B8C4D4"/></StackPanel>
   <StackPanel Orientation="Horizontal" Margin="14,0,0,0"><Ellipse x:Name="GsDot" Width="7" Height="7" Fill="#7E8B9B" Margin="0,0,8,0"/><TextBlock x:Name="GsBadge" Text="Servers stopped" FontSize="11" Foreground="#B8C4D4"/></StackPanel>
   <Button x:Name="OpenInstallFolder" Content="Open repack folder  ↗" Background="Transparent" BorderBrush="Transparent" FontSize="11" Foreground="#C5D2EC" Margin="0,14,0,0" Padding="8"/>
  </StackPanel>

  <Grid Margin="286,204,73,205">
   <Border x:Name="HubPanel" Background="#D80C1022" BorderBrush="#668E836B" BorderThickness="1" Padding="28,22" CornerRadius="6">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="ALL-IN-ONE REPACK SETUP &amp; UPDATER" Foreground="#E8CB91" FontSize="10"/>
      <TextBlock x:Name="HeroHeadline" Text="One Click. Ready to Play." FontFamily="Palatino Linotype" FontSize="31" Margin="0,5,0,10"/>
      <TextBlock x:Name="HeroDescription" Text="Download the full 0.86 portable repack via BitTorrent or direct archive, verify every file automatically, and apply future updates in seconds without touching your characters or database." FontSize="13" LineHeight="20" Foreground="#D4DCE8" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0">
      <Border Background="#99141B34" BorderBrush="#448E836B" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,12">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="INSTALL LOCATION" Foreground="#E8CB91" FontSize="10"/>
         <TextBlock x:Name="InstallPathLabel" Text="C:\Games\Aetherfall-0.86" FontSize="13" Foreground="#EEF4F5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button x:Name="BrowseInstall" Grid.Column="1" Content="Change Folder…" Padding="14,7" FontSize="12" Margin="12,0,0,0"/>
       </Grid>
      </Border>
      <Border Background="#99141B34" BorderBrush="#448E836B" BorderThickness="1" CornerRadius="4" Padding="16,12">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="UPDATES &amp; ARCHIVE SOURCE" Foreground="#E8CB91" FontSize="10"/>
         <TextBlock x:Name="ArchiveSourceLabel" Text="Auto: BitTorrent Swarm + Local Aetherfall-0.86.7z Detection" FontSize="12" Foreground="#D6DFEC" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button x:Name="SelectArchiveBtn" Grid.Column="1" Content="Use Local .7z…" Padding="12,7" FontSize="12" Margin="10,0,0,0" ToolTip="Pick an Aetherfall-0.86.7z file you already downloaded from MEGA or Google Drive"/>
        <Button x:Name="UpdateNowBtn" Grid.Column="2" Content="↻  Update Repack" Padding="15,7" FontSize="12" Margin="8,0,0,0" Background="#263B5E" BorderBrush="#E8CB91" ToolTip="Check for updates or install a small Aetherfall-Patch ZIP"/>
       </Grid>
      </Border>
     </StackPanel>
     <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
      <CheckBox x:Name="DeleteArchiveAfter" Content="Delete temporary .7z archive after extraction to free 36 GB" Foreground="#D4DCE8" FontSize="12" VerticalAlignment="Center"/>
     </StackPanel>
    </Grid>
   </Border>

   <Border x:Name="ServersPanel" Visibility="Collapsed" Background="#EB0C1022" BorderBrush="#788E836B" BorderThickness="1" Padding="28,22" CornerRadius="6">
    <StackPanel>
     <TextBlock Text="LOCAL PORTABLE SERVER CONTROL" Foreground="#E8CB91" FontSize="10"/>
     <TextBlock Text="Manage Database &amp; World Servers" FontFamily="Palatino Linotype" FontSize="28" Margin="0,6,0,10"/>
     <TextBlock Text="Start and stop the bundled MariaDB database and Aion 4.8 servers directly from here — no batch scripts needed." FontSize="13" Foreground="#D4DCE8" Margin="0,0,0,18" TextWrapping="Wrap"/>
     <WrapPanel Margin="0,0,0,16">
      <Button x:Name="StartAllServerBtn" Content="▶  1. Start Database &amp; Servers" Padding="18,12" Margin="0,0,12,12" Background="#1F473E" BorderBrush="#88A6E5C3" FontSize="13"/>
      <Button x:Name="StartDbOnlyBtn" Content="Start Database Only" Padding="15,12" Margin="0,0,12,12"/>
      <Button x:Name="StartGsOnlyBtn" Content="Start Servers Only" Padding="15,12" Margin="0,0,12,12"/>
      <Button x:Name="StopAllServerBtn" Content="■  Stop Database" Padding="16,12" Margin="0,0,12,12" Background="#4A2028" BorderBrush="#99E59A9A"/>
     </WrapPanel>
     <TextBlock x:Name="ServerControlFeedback" Text="Database uses portable port 33306. LoginServer listens on port 2106." FontSize="12" Foreground="#EAD29E" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>

   <Border x:Name="PathsPanel" Visibility="Collapsed" Background="#EB0C1022" BorderBrush="#788E836B" BorderThickness="1" Padding="28,22" CornerRadius="6">
    <StackPanel>
     <TextBlock Text="DOWNLOAD MODE &amp; ONLINE UPDATE CHANNEL" Foreground="#E8CB91" FontSize="10"/>
     <TextBlock Text="Download &amp; Update Settings" FontFamily="Palatino Linotype" FontSize="27" Margin="0,6,0,16"/>
     <TextBlock Text="DOWNLOAD METHOD" Foreground="#B8C4D8" FontSize="10" Margin="0,0,0,8"/>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <RadioButton x:Name="ModeAuto" Content="Auto (Local .7z / Torrent / HTTP)" GroupName="DlMode" IsChecked="True"/>
      <RadioButton x:Name="ModeTorrent" Content="BitTorrent Swarm" GroupName="DlMode"/>
      <RadioButton x:Name="ModeHttp" Content="Direct HTTPS Mirrors" GroupName="DlMode"/>
     </StackPanel>
     <TextBlock Text="AUTO-UPDATE MANIFEST URL (OPTIONAL)" Foreground="#B8C4D8" FontSize="10" Margin="0,0,0,6"/>
     <TextBox x:Name="UpdateUrlBox" Height="30" Background="#12172B" Foreground="#EEF4F5" BorderBrush="#668E836B" Padding="8,4" FontSize="12" Margin="0,0,0,14"/>
     <StackPanel Orientation="Horizontal">
      <Button x:Name="SavePathsBtn" Content="Save Settings" Padding="20,9" Margin="0,0,12,0"/>
      <Button x:Name="ApplyPatchFileBtn" Content="Select &amp; Apply Patch .zip Manually…" Padding="16,9"/>
     </StackPanel>
     <TextBlock x:Name="PathsFeedback" Foreground="#EAD29E" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </Grid>

  <Grid Margin="110,0,110,70" Height="126" VerticalAlignment="Bottom">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,6,35,0" VerticalAlignment="Top">
    <Grid Margin="0,0,0,6">
     <StackPanel x:Name="StatusHeading" Orientation="Horizontal" HorizontalAlignment="Left"><TextBlock x:Name="StatusBanner" Text="AETHERFALL REPACK MANAGER" Foreground="#E4CA94" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="StageCount" Text="" Foreground="#9CDEC3" FontSize="12" FontWeight="Bold" Margin="18,0,0,0"/></StackPanel>
     <TextBlock x:Name="ProgressPercentLabel" Text="" Foreground="#F6DFB0" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
    </Grid>
    <TextBlock x:Name="StatusTitle" Text="Ready to install or update." FontFamily="Palatino Linotype" FontSize="23"/>
    <TextBlock x:Name="StatusDetail" Text="Press Install to download and extract the repack, or Update to apply the latest patch." Foreground="#C4D5DE" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap" MaxHeight="36"/>
    <Border CornerRadius="4" BorderBrush="#669B8E6E" BorderThickness="1" Background="#55161E2E" Height="10" ClipToBounds="True">
     <Grid x:Name="ProgressTrack" Height="10" ClipToBounds="True" Background="#00000000"><Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" Background="#E5AF41"/><Rectangle x:Name="ProgressShine" Width="92" HorizontalAlignment="Left" Opacity="0"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00A6C8FA"/><GradientStop Color="#FFD4E4FF" Offset="0.5"/><GradientStop Color="#00A6C8FA" Offset="1"/></LinearGradientBrush></Rectangle.Fill><Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform></Rectangle></Grid>
    </Border>
   </StackPanel>
   <StackPanel Grid.Column="1" Margin="0,4,0,0">
    <Button x:Name="PrimaryBtn" Height="72" Padding="0" BorderBrush="#E6C98D" Background="#D522325A">
     <Button.Effect><DropShadowEffect x:Name="PrimaryGlow" Color="#7BA7F7" BlurRadius="24" ShadowDepth="0" Opacity="0.28"/></Button.Effect>
     <StackPanel Orientation="Horizontal"><TextBlock Text="◆" FontSize="15" VerticalAlignment="Center" Foreground="#E5C788" Margin="0,0,15,0"/><TextBlock x:Name="PrimaryLabel" Text="INSTALL" FontFamily="Palatino Linotype" FontSize="25"/><TextBlock Text="›" FontSize="27" VerticalAlignment="Center" Foreground="#E5C788" Margin="15,0,0,0"/></StackPanel>
    </Button>
    <TextBlock x:Name="LaunchCaption" Text="ONE-CLICK INSTALLER  ·  DELTA UPDATER" Foreground="#C4D3D9" FontSize="10" HorizontalAlignment="Center" Margin="0,13,0,0"/>
   </StackPanel>
  </Grid>
  <Image x:Name="Frame" Stretch="Fill" IsHitTestVisible="False"/>
 </Grid></Viewbox>
</Window>
