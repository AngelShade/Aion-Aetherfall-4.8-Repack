+// Aetherfall: [CameraFix] Mode in mods.ini next to version.dll.
+// corrected (default) keeps first-move direction, upstream is the original
+// behavior, off leaves the camera input untouched.
+enum class CameraFixMode { Corrected, Upstream, Off };
+static CameraFixMode cameraFixMode = CameraFixMode::Corrected;
+
+static void ReadCameraFixMode() {
+    HMODULE self = nullptr;
+    wchar_t path[MAX_PATH] = {};
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, (LPCWSTR)&ReadCameraFixMode, &self) ||
+        !GetModuleFileNameW(self, path, MAX_PATH)) {
+        return;
+    }
+    wchar_t* slash = wcsrchr(path, L'\\');
+    if (!slash || wcscpy_s(slash + 1, MAX_PATH - (slash + 1 - path), L"mods.ini")) {
+        return;
+    }
+    wchar_t mode[16] = {};
+    GetPrivateProfileStringW(L"CameraFix", L"Mode", L"corrected", mode, 16, path);
+    if (_wcsicmp(mode, L"upstream") == 0) cameraFixMode = CameraFixMode::Upstream;
+    else if (_wcsicmp(mode, L"off") == 0) cameraFixMode = CameraFixMode::Off;
+}
 
 
