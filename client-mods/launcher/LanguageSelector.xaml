<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" TextElement.FontFamily="Tahoma">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel>
  <TextBlock Text="ON-SCREEN TEXT" Foreground="#D6B878" FontSize="10" Margin="0,0,0,7"/>
  <ComboBox x:Name="SelectedText" Style="{DynamicResource LanguageCombo}" DisplayMemberPath="Name" Height="40"/>
 </StackPanel>
 <StackPanel Grid.Row="1" Margin="0,17,0,0">
  <TextBlock Text="CHARACTER &amp; NPC VOICES" Foreground="#D6B878" FontSize="10" Margin="0,0,0,7"/>
  <ComboBox x:Name="SelectedVoice" Style="{DynamicResource LanguageCombo}" DisplayMemberPath="Name" Height="40"/>
 </StackPanel>
 <TextBlock x:Name="SelectionHint" Grid.Row="2" FontSize="11" Foreground="#93ABBC" TextWrapping="Wrap" Margin="0,12,0,13"/>
 <StackPanel Grid.Row="3">
  <Button x:Name="ApplySelection" Content="Apply languages" Style="{DynamicResource LanguagePrimary}" HorizontalAlignment="Left" Padding="20,9"/>
  <TextBlock x:Name="SelectionFeedback" Text="Selections save for your next Play." FontSize="11" Foreground="#8FD8B4" TextWrapping="Wrap" Margin="0,9,0,0"/>
 </StackPanel>
</Grid>
