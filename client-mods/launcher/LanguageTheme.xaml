<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="LanguageFlat" TargetType="Button">
  <Setter Property="Foreground" Value="#DFE9F0"/><Setter Property="FontFamily" Value="Tahoma"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="10,7"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Plate" Background="#142538" BorderBrush="#2E4A61" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#8FE3EC"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#8FE3EC"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Background" Value="#0A1521"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="LanguagePrimary" TargetType="Button" BasedOn="{StaticResource LanguageFlat}">
  <Setter Property="Foreground" Value="#1A1206"/><Setter Property="FontWeight" Value="Bold"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Plate" BorderBrush="#8A6D3C" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F1DCA8"/><GradientStop Color="#D6B878" Offset="0.55"/><GradientStop Color="#B08E52" Offset="1"/></LinearGradientBrush></Border.Background><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#F4E8C8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#8FE3EC"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="LanguageItem" TargetType="ComboBoxItem">
  <Setter Property="Foreground" Value="#DFE9F0"/><Setter Property="Background" Value="#0A1521"/><Setter Property="Padding" Value="12,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="IsEnabled" Value="{Binding Available}"/><Setter Property="ToolTip" Value="{Binding Description}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#D6B878"/><Setter TargetName="Plate" Property="Background" Value="#142538"/><Setter Property="Foreground" Value="#F4E8C8"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Plate" Property="Background" Value="#1D3849"/><Setter TargetName="Plate" Property="BorderBrush" Value="#8FE3EC"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="LanguageCombo" TargetType="ComboBox">
  <Setter Property="Foreground" Value="#DFE9F0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Tahoma"/><Setter Property="ItemContainerStyle" Value="{StaticResource LanguageItem}"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
   <Grid><Border x:Name="Frame" Background="#0A1521" BorderBrush="#8A6D3C" BorderThickness="1" CornerRadius="2"><Grid><ContentPresenter Content="{TemplateBinding SelectedItem}" Margin="13,0,38,0" VerticalAlignment="Center" IsHitTestVisible="False"><ContentPresenter.ContentTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ContentPresenter.ContentTemplate></ContentPresenter><Path Data="M 0 0 L 5 5 L 10 0" Stroke="#D6B878" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/></Grid></Border>
    <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#0A1521" BorderBrush="#8A6D3C" BorderThickness="1" Padding="1"><ScrollViewer MaxHeight="285" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#8FE3EC"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#8FE3EC"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="CheckBox">
  <Setter Property="Foreground" Value="#DFE9F0"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="MarkFrame" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#0A1521" BorderBrush="#8A6D3C" BorderThickness="1"><Path x:Name="Mark" Data="M 2 7 L 5 10 L 12 3" Stroke="#8FE3EC" StrokeThickness="2" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MarkFrame" Property="BorderBrush" Value="#8FE3EC"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MarkFrame" Property="BorderBrush" Value="#8FE3EC"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="RadioButton">
  <Setter Property="Foreground" Value="#DFE9F0"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,22,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><StackPanel Orientation="Horizontal" Background="Transparent"><Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"><Ellipse x:Name="Ring" Fill="#0A1521" Stroke="#8A6D3C"/><Ellipse x:Name="Dot" Fill="#8FE3EC" Width="7" Height="7" Visibility="Collapsed"/></Grid><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#8FE3EC"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#8FE3EC"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ScrollBar">
  <Setter Property="Width" Value="7"/><Setter Property="MinWidth" Value="7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="#070D16" CornerRadius="3"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#2E4A61" CornerRadius="3" Margin="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#3A9FBE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="LanguageProgress" TargetType="ProgressBar"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="#1F3447"><Border x:Name="PART_Indicator" Background="#8FE3EC" HorizontalAlignment="Left"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
