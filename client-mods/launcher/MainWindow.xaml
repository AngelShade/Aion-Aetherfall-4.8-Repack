<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aion Aetherfall Launcher"
 Width="1180" Height="744" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
 Background="Transparent" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="#EEF4F5">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#F6EEE0"/>
   <Setter Property="Background" Value="#142B39"/><Setter Property="BorderBrush" Value="#66778778"/>
   <Setter Property="Padding" Value="14,10"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
     BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="#285063"/><Setter TargetName="Plate" Property="BorderBrush" Value="#E5C78D"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#E5C78D"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.72"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.48"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,9"/>
   <Setter Property="Padding" Value="14,13"/>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E4EAF0"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#F2EBDD"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,0,24,0"/></Style>
 </Window.Resources>
 <Viewbox Stretch="Uniform"><Grid x:Name="Scene" Width="1180" Height="744">
  <Border Margin="13" Background="#07121D" CornerRadius="19"/>
  <Border Margin="17" CornerRadius="17" ClipToBounds="True"><Grid>
   <Image x:Name="Hero" Stretch="UniformToFill"/>
   <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F507111D" Offset="0"/><GradientStop Color="#E5091623" Offset="0.19"/><GradientStop Color="#9B081421" Offset="0.45"/><GradientStop Color="#00081321" Offset="0.76"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#FF07111D" Offset="0"/><GradientStop Color="#F0071420" Offset="0.18"/><GradientStop Color="#00061421" Offset="0.65"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <Canvas x:Name="Motes" IsHitTestVisible="False" ClipToBounds="True"/>
  </Grid></Border>
  <Border x:Name="DragArea" Margin="60,32,146,0" Height="116" VerticalAlignment="Top" Background="Transparent"/>
  <StackPanel Margin="148,52,0,0" Width="355" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
   <Image x:Name="AionLogo" Width="173" Height="45" Stretch="Uniform"/>
   <Image x:Name="AetherfallLogo" Width="355" Height="80" Stretch="Uniform" Margin="0,-1,0,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"><Rectangle Width="26" Height="1" Fill="#D3B980" VerticalAlignment="Center"/><TextBlock x:Name="ReleaseLabel" FontSize="10" Foreground="#D4DDE2"/></StackPanel>
  </StackPanel>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,81,171,0">
   <Button x:Name="Minimize" Content="−" Width="32" Height="29" Padding="0" Margin="0,0,7,0" Background="#A6081621" ToolTip="Minimize"/>
   <Button x:Name="Exit" Content="×" Width="32" Height="29" Padding="0" Background="#A6081621" ToolTip="Close launcher"/>
  </StackPanel>
  <StackPanel Margin="60,220,0,0" Width="178" HorizontalAlignment="Left" VerticalAlignment="Top">
   <Button x:Name="OverviewTab" Style="{StaticResource Nav}" Background="#B8203A48" BorderBrush="#7477998E"><TextBlock Text="◇    YOUR ADVENTURE" FontSize="12"/></Button>
   <Button x:Name="ModsTab" Style="{StaticResource Nav}"><TextBlock Text="✧    INSTALLED MODS" FontSize="12"/></Button>
   <Button x:Name="SettingsTab" Style="{StaticResource Nav}"><TextBlock Text="⚙    LAUNCH SETTINGS" FontSize="12"/></Button>
   <Border Height="1" Background="#497F9297" Margin="14,19,18,22"/>
   <TextBlock Text="CONNECTION" Foreground="#B8C8D0" FontSize="10" Margin="14,0,0,12"/>
   <StackPanel Orientation="Horizontal" Margin="14,0,0,0"><Ellipse x:Name="ServerDot" Width="6" Height="6" Fill="#CFAD72" Margin="0,0,8,0"/><TextBlock x:Name="ServerStatus" Text="Checking server…" FontSize="12" Foreground="#ECDFCA"/></StackPanel>
   <TextBlock x:Name="ServerAddress" Text="127.0.0.1 : 2106" Foreground="#B3C7D1" FontSize="11" Margin="28,6,0,0"/>
   <Button x:Name="Folder" Content="Open client folder  ↗" Background="Transparent" BorderBrush="Transparent" FontSize="11" Foreground="#BBD5DF" Margin="0,16,0,0" Padding="8"/>
  </StackPanel>
  <Grid Margin="286,211,73,207">
   <StackPanel x:Name="OverviewPanel" VerticalAlignment="Center">
    <TextBlock Text="THE WORLD BEYOND THE RIFT" Foreground="#E8CB91" FontSize="11" Margin="2,0,0,17"/>
    <TextBlock FontFamily="Palatino Linotype" FontSize="55" LineHeight="59" TextWrapping="Wrap" Width="500" HorizontalAlignment="Left" Text="Spread your&#10;wings.">
     <TextBlock.Effect><DropShadowEffect Color="#000A13" BlurRadius="18" ShadowDepth="2" Opacity="0.9"/></TextBlock.Effect>
    </TextBlock>
    <TextBlock Text="Bring your companions. Choose your journey.&#10;Atreia is waiting." FontSize="16" LineHeight="25" Foreground="#E0E9ED" Margin="3,19,0,0"/>
   </StackPanel>
   <Border x:Name="ModsPanel" Visibility="Collapsed" Background="#EF091722" BorderBrush="#786A8D96" BorderThickness="1" Padding="25,19" CornerRadius="5">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="YOUR AETHERFALL" Foreground="#E8CB91" FontSize="10"/><TextBlock Text="A familiar world. More possibilities." FontFamily="Palatino Linotype" FontSize="25" Margin="0,7,0,12"/></StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ModList"/></ScrollViewer>
     <Button x:Name="OpenMods" Grid.Row="2" Content="Open Mods folder  ↗" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,7"/>
    </Grid>
   </Border>
   <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="#EF091722" BorderBrush="#786A8D96" BorderThickness="1" Padding="25,21" CornerRadius="5">
    <StackPanel><TextBlock Text="MAKE IT YOURS" Foreground="#E8CB91" FontSize="10"/><TextBlock Text="Launch settings" FontFamily="Palatino Linotype" FontSize="27" Margin="0,7,0,18"/>
     <TextBlock Text="GRAPHICS RENDERER" Foreground="#B8CCD5" FontSize="10" Margin="0,0,0,12"/>
     <StackPanel Orientation="Horizontal"><RadioButton x:Name="Vulkan" Content="Vulkan / DXVK" GroupName="Renderer"/><RadioButton x:Name="Direct3D" Content="Direct3D 9" GroupName="Renderer"/></StackPanel>
     <TextBlock Text="Applies on the next game launch. Keep Aion closed to change it." Foreground="#BCD0DA" FontSize="12" Margin="0,10,0,19"/>
     <CheckBox x:Name="Animations" Content="Animated aether and ambient particles" IsChecked="True"/>
     <CheckBox x:Name="CloseAfter" Content="Close launcher when the login screen is ready" IsChecked="False"/>
     <Button x:Name="SaveSettings" Content="Save settings" HorizontalAlignment="Left" Padding="22,9"/>
     <TextBlock x:Name="SettingsFeedback" Foreground="#EAD29E" FontSize="12" TextWrapping="Wrap" Margin="0,11,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
  <Grid Margin="110,0,110,70" Height="126" VerticalAlignment="Bottom">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,8,35,0" VerticalAlignment="Top">
    <StackPanel x:Name="StatusHeading" Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="READY FOR YOUR NEXT CHAPTER" Foreground="#E4CA94" FontSize="10"/><TextBlock x:Name="StageCount" Text="" Foreground="#C7D8DE" FontSize="10" Margin="16,0,0,0"/></StackPanel>
    <TextBlock x:Name="StatusTitle" Text="Welcome back, Daeva." FontFamily="Palatino Linotype" FontSize="24"/>
    <TextBlock x:Name="StatusDetail" Text="Your installed mods will be prepared when you press Play." Foreground="#C4D5DE" FontSize="12" Margin="0,5,0,12" TextWrapping="Wrap" MaxHeight="37"/>
    <Grid x:Name="ProgressTrack" Height="4" ClipToBounds="True" Background="#334E6C7C"><Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" Background="#D9C492"/><Rectangle x:Name="ProgressShine" Width="92" HorizontalAlignment="Left" Opacity="0"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#0076E6FA"/><GradientStop Color="#FFB1ECF6" Offset="0.5"/><GradientStop Color="#0076E6FA" Offset="1"/></LinearGradientBrush></Rectangle.Fill><Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform></Rectangle></Grid>
    <Button x:Name="OpenLog" Content="View launch log  ↗" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="0" FontSize="11" Background="Transparent" BorderBrush="Transparent"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Margin="0,4,0,0">
    <Button x:Name="Play" Height="72" Padding="0" BorderBrush="#E6C98D" Background="#D5194756">
     <Button.Effect><DropShadowEffect x:Name="PlayGlow" Color="#67D7ED" BlurRadius="24" ShadowDepth="0" Opacity="0.24"/></Button.Effect>
     <StackPanel Orientation="Horizontal"><TextBlock Text="◆" FontSize="15" VerticalAlignment="Center" Foreground="#E5C788" Margin="0,0,19,0"/><TextBlock x:Name="PlayLabel" Text="PLAY" FontFamily="Palatino Linotype" FontSize="28"/><TextBlock Text="›" FontSize="27" VerticalAlignment="Center" Foreground="#E5C788" Margin="19,0,0,0"/></StackPanel>
    </Button><TextBlock x:Name="LaunchCaption" Text="AION 4.8  ·  64-BIT CLIENT" Foreground="#C4D3D9" FontSize="10" HorizontalAlignment="Center" Margin="0,13,0,0"/>
   </StackPanel>
  </Grid>
  <Image x:Name="Frame" Stretch="Fill" IsHitTestVisible="False"/>
 </Grid></Viewbox>
</Window>
